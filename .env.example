# Postgres (matches docker-compose service defaults, override if needed)
DATABASE_URL=postgresql+psycopg2://scrapetrack:scrapetrack@postgres:5432/scrapetrack

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# Scraping behavior
DEFAULT_USER_AGENT=Mozilla/5.0 (compatible; ScrapeTrackBot/1.0; +local-tool)
REQUEST_TIMEOUT_SECONDS=15
MAX_FETCH_RETRIES=1
RETRY_BACKOFF_SECONDS=2.0
PLAYWRIGHT_NAV_TIMEOUT_SECONDS=20

# Scheduling
MIN_POLL_INTERVAL_SECONDS=300
DISPATCH_INTERVAL_SECONDS=60
